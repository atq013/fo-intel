# Copy to .env and fill in. .env is gitignored.

# --- Required ---

# SEC asks every automated caller to declare a contact. Without a real one they 403.
# Format: "Full Name email@domain.com"
SEC_USER_AGENT=

# Google AI Studio - https://aistudio.google.com/apikey
# Embeddings (text-embedding-004) + generation (Gemini Flash).
GEMINI_API_KEY=

# Groq - https://console.groq.com/keys
# Second, independent model. Used by the attribution checker so the model
# verifying a claim is never the model that wrote it.
GROQ_API_KEY=

# Neon - https://neon.tech  (Postgres + pgvector)
# Copy the pooled connection string from the project dashboard.
DATABASE_URL=

# Serper - https://serper.dev  (2,500 free queries)
# Programmatic web search: conference programmes, job postings, news.
SERPER_API_KEY=

# --- Optional, improves contact coverage ---

# Hunter - https://hunter.io  (25/month free)
# Domain search returns *published* addresses, which feed the top verification tier.
HUNTER_API_KEY=

# ZeroBounce - https://www.zerobounce.net  (100 free credits)
# Deliverability checking when the SMTP probe is blocked.
ZEROBOUNCE_API_KEY=

# Companies House - https://developer.company-information.service.gov.uk
# Free UK company + officer data. Adds real geographic breadth.
COMPANIES_HOUSE_API_KEY=
